# ============================================================
# ScanForge — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=ScanForge
APP_URL=http://localhost:8000
PORT=8000

# Frontend URL (for CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Neon Postgres) ─────────────────────────────────
# Note: Do NOT include ?sslmode= in the URL when using asyncpg dialect
# SSL is configured via connect_args in app/db/session.py
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── Auth (Neon Auth) ────────────────────────────────────────
NEON_AUTH_ISSUER=https://your-project-id.neon.tech
NEON_AUTH_AUDIENCE=scanforge-api
NEON_AUTH_JWKS_URL=https://your-project-id.neon.tech/.well-known/jwks.json
NEON_AUTH_CLIENT_ID=your-client-id
NEON_AUTH_CLIENT_SECRET=your-client-secret

# ── Queue (Upstash Redis) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ── Storage (Cloudflare R2) ────────────────────────────────
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET=scanforge-artifacts
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_PUBLIC_BASE_URL=https://cdn.your-domain.com

# ── GitHub App (optional) ───────────────────────────────────
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-app-slug-here
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# GITHUB_PRIVATE_KEY should be stored as a Render secret, not here
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."

# ── Internal Service Auth ───────────────────────────────────
INTERNAL_API_KEY=your-internal-api-key-here

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USERNAME=your-username
SMTP_PASSWORD=your-password
SMTP_FROM=scanforge@your-domain.com

# ── Notifications ───────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── CORS ───────────────────────────────────────────────────
# Comma-separated origins (no spaces), used by FastAPI
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Scanner Binaries ───────────────────────────────────────
TRIVY_BINARY=trivy
GITLEAKS_BINARY=gitleaks
OSV_SCANNER_BINARY=osv-scanner
SYFT_BINARY=syft
GRYPE_BINARY=grype
SEMGREP_BINARY=semgrep
CHECKOV_BINARY=checkov
