APP_ENV=private-beta
AI_ENABLED=false
API_BASE_URL=https://api.scanforge.example
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=
WORKER_CREDENTIAL=
WORKER_ORGANIZATION_ID=
WORKER_CONSUMER_NAME=
WORKER_CONCURRENCY=1
WORKER_WORKSPACE_ROOT=/var/lib/scanforge/workspaces
SCANNER_IMAGE=registry.example/scanforge-scanners@sha256:
# API-only credentials (DATABASE_URL, R2_SECRET_ACCESS_KEY, WORKER_CREDENTIAL_PEPPER) are deliberately not present in this file.

