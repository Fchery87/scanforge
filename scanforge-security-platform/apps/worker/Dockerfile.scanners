# syntax=docker/dockerfile:1.7
# Debian 12 Python base pinned to a digest; scanner versions are immutable build args.
FROM python:3.12.8-slim-bookworm@sha256:3cce65a9b53e85a94b8c76bb27bc4eab5049b21c4414ea8f4cdf7dc59b7fddd8 AS scanner

ARG TRIVY_VERSION=0.69.3
ARG GITLEAKS_VERSION=8.30.0
ARG SEMGREP_VERSION=1.156.0
ARG CHECKOV_VERSION=3.2.513
ARG SYFT_VERSION=1.42.3
ARG GRYPE_VERSION=0.110.0
ARG OSV_SCANNER_VERSION=2.3.3

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git jq tar \
    && rm -rf /var/lib/apt/lists/*

# Trusted image builds download pinned releases and scanner databases. Runtime
# containers have --network=none, so customer scans cannot update or exfiltrate.
RUN pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" "checkov==${CHECKOV_VERSION}"
RUN curl --fail --location --silent --show-error \
      "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
      | tar -xz -C /usr/local/bin trivy \
    && curl --fail --location --silent --show-error \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
      | tar -xz -C /usr/local/bin gitleaks \
    && curl --fail --location --silent --show-error \
      "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz" \
      | tar -xz -C /usr/local/bin syft \
    && curl --fail --location --silent --show-error \
      "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz" \
      | tar -xz -C /usr/local/bin grype \
    && curl --fail --location --silent --show-error \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64" \
      -o /usr/local/bin/osv-scanner \
    && chmod 0555 /usr/local/bin/osv-scanner

RUN trivy --version | grep -F "Version: ${TRIVY_VERSION}" \
    && gitleaks version | grep -F "${GITLEAKS_VERSION}" \
    && semgrep --version | grep -Fx "${SEMGREP_VERSION}" \
    && checkov --version | grep -Fx "${CHECKOV_VERSION}" \
    && syft version | grep -F "Version: ${SYFT_VERSION}" \
    && grype version | grep -F "Version: ${GRYPE_VERSION}" \
    && osv-scanner --version | grep -F "${OSV_SCANNER_VERSION}"

COPY app/scanners/rules/ /opt/scanner-rules/

RUN mkdir -p /opt/scanner-db/trivy /opt/scanner-db/grype /opt/scanner-db/osv/osv-scanner /workspace/source /workspace/output \
    && trivy image --download-db-only --cache-dir /opt/scanner-db/trivy \
    && grype db update --db-root-dir /opt/scanner-db/grype \
    && curl --fail --location --silent --show-error \
      https://osv-vulnerabilities.storage.googleapis.com/ecosystems.txt -o /tmp/osv-ecosystems.txt \
    && tr -d '\r' < /tmp/osv-ecosystems.txt > /tmp/osv-ecosystems-clean.txt \
    && while IFS= read -r ecosystem; do \
      [ -n "$ecosystem" ] || continue; \
      encoded_ecosystem="$(printf '%s' "$ecosystem" | jq -sRr @uri)"; \
      mkdir -p "/opt/scanner-db/osv/osv-scanner/$ecosystem"; \
      curl --fail --location --silent --show-error --retry 3 \
        "https://osv-vulnerabilities.storage.googleapis.com/${encoded_ecosystem}/all.zip" \
        -o "/opt/scanner-db/osv/osv-scanner/$ecosystem/all.zip" || exit 1; \
    done < /tmp/osv-ecosystems-clean.txt \
    && TRIVY_DB_DIGEST="sha256:$(find /opt/scanner-db/trivy -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d" " -f1)" \
    GRYPE_DB_DIGEST="sha256:$(find /opt/scanner-db/grype -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d" " -f1)" \
    OSV_DB_DIGEST="sha256:$(find /opt/scanner-db/osv -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d" " -f1)" \
    python3 -c 'import datetime, hashlib, json, os, pathlib; \
now = datetime.datetime.now(datetime.timezone.utc).isoformat(); \
semgrep_rules = pathlib.Path("/opt/scanner-rules/semgrep-rules.yml").read_bytes(); \
semgrep_digest = "sha256:" + hashlib.sha256(semgrep_rules).hexdigest(); \
manifest = { \
  "schema_version": "2026-10-manifest.v1", \
  "generated_at": now, \
  "trivy": "'"$TRIVY_VERSION"'", \
  "gitleaks": "'"$GITLEAKS_VERSION"'", \
  "semgrep": "'"$SEMGREP_VERSION"'", \
  "checkov": "'"$CHECKOV_VERSION"'", \
  "syft": "'"$SYFT_VERSION"'", \
  "grype": "'"$GRYPE_VERSION"'", \
  "osv-scanner": "'"$OSV_SCANNER_VERSION"'", \
  "scanners": { \
    "trivy": {"scanner_version": "'"$TRIVY_VERSION"'", "parser_version": "2026-10-parser.v1", "db_backed": True, "db_published_at": now, "db_digest": os.environ["TRIVY_DB_DIGEST"]}, \
    "gitleaks": {"scanner_version": "'"$GITLEAKS_VERSION"'", "parser_version": "2026-10-parser.v1", "db_backed": False}, \
    "semgrep": {"scanner_version": "'"$SEMGREP_VERSION"'", "parser_version": "2026-10-parser.v1", "db_backed": False, "rules_digest": semgrep_digest}, \
    "checkov": {"scanner_version": "'"$CHECKOV_VERSION"'", "parser_version": "2026-10-parser.v1", "db_backed": False}, \
    "syft": {"scanner_version": "'"$SYFT_VERSION"'", "parser_version": "2026-10-parser.v1", "db_backed": False}, \
    "grype": {"scanner_version": "'"$GRYPE_VERSION"'", "parser_version": "2026-10-parser.v1", "db_backed": True, "db_published_at": now, "db_digest": os.environ["GRYPE_DB_DIGEST"]}, \
    "osv": {"scanner_version": "'"$OSV_SCANNER_VERSION"'", "parser_version": "2026-10-parser.v1", "db_backed": True, "db_published_at": now, "db_digest": os.environ["OSV_DB_DIGEST"]} \
  } \
}; \
pathlib.Path("/opt/scanner-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")' \
    && useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin scanner \
    && chown -R 65532:65532 /workspace/output \
    && chmod -R a+rX /opt/scanner-db /opt/scanner-rules /opt/scanner-manifest.json

ENV TRIVY_CACHE_DIR=/opt/scanner-db/trivy \
    GRYPE_DB_ROOT_DIR=/opt/scanner-db/grype \
    OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=/opt/scanner-db/osv \
    TRIVY_SKIP_DB_UPDATE=true \
    TRIVY_OFFLINE_SCAN=true \
    GRYPE_DB_AUTO_UPDATE=false \
    GRYPE_DB_VALIDATE_AGE=false \
    SEMGREP_SEND_METRICS=off
USER 65532:65532
WORKDIR /workspace/source
ENTRYPOINT []
